{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "christianwhitmer-blog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-13",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "GITHUB_OWNER": "cwhit-io",
    "GITHUB_REPO": "christianwhitmer.com",
    "GITHUB_BRANCH": "main"
  }
}
