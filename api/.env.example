# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS origin — set to your domain in production, or leave * for open
# CORS_ORIGIN=https://christianwhitmer.com

# ─── Authentication ───────────────────────────────────────────────────────────
# Shared secret for bearer-token auth on all mutating endpoints.
# Use a strong random value in production: openssl rand -hex 32
API_TOKEN=changeme

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_yourPersonalAccessToken
GITHUB_OWNER=cwhit-io
GITHUB_REPO=christianwhitmer.com
GITHUB_BRANCH=master

# ─── Content paths ────────────────────────────────────────────────────────────
# Must match the path used in the Cloudflare Worker (wrangler.jsonc POSTS_DIR).
POSTS_BASE_PATH=src/content/blog

# Author name used for new posts when not specified in the request.
DEFAULT_AUTHOR=Christian Whitmer

# ─── Media (GitHub fallback) ─────────────────────────────────────────────────
REPO_IMAGE_BASE_PATH=public/images/blog
PUBLIC_IMAGE_BASE_PATH=/images/blog
# 2 MB default
MAX_MEDIA_BYTES=2097152

# ─── Cloudflare R2 media storage (optional) ───────────────────────────────────
# When all four R2_* vars are set, media uploads go to R2 instead of GitHub.
# Create an API token at: https://dash.cloudflare.com/ → R2 → Manage API Tokens
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-bucket-name
# Public URL for the bucket (custom domain or r2.dev subdomain)
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev
# Sub-path within the bucket for blog images (default: images/blog)
# R2_IMAGE_BASE_PATH=images/blog

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
DEFAULT_IMAGE_SIZE=1024x1024
DEFAULT_IMAGE_QUALITY=low
DEFAULT_IMAGE_FORMAT=webp

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "false" to make GET /posts and GET /posts/:slug public.
# Existing Worker behaviour: reads were protected. Default here matches that.
PROTECT_READS=true
