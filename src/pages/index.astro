---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import BlogIntro from "../components/BlogIntro.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";

const POSTS_PER_PAGE = 6;

const allPosts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Get the latest post for hero
const latestPost = allPosts[0];

// For pagination, skip the first post since it's featured
const remainingPosts = allPosts.slice(1);

const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam ?? "1") || 1);
const totalPages = Math.max(1, Math.ceil(remainingPosts.length / POSTS_PER_PAGE));
const safePage = Math.min(currentPage, totalPages);

const posts = remainingPosts.slice(
    (safePage - 1) * POSTS_PER_PAGE,
    safePage * POSTS_PER_PAGE,
);

const prevUrl = safePage > 1 ? `/?page=${safePage - 1}#blog` : null;
const nextUrl = safePage < totalPages ? `/?page=${safePage + 1}#blog` : null;
---

<Layout>
    {latestPost && (
        <FeaturedPost
            title={latestPost.data.title}
            description={latestPost.data.description}
            date={latestPost.data.date}
            author={latestPost.data.author}
            slug={latestPost.slug}
            image={latestPost.data.image}
            headerImage={latestPost.data.headerImage}
        />
    )}

    <BlogIntro />

    <!-- Posts grid -->
    <section id="blog" class="posts-section">
        <h2 class="section-label">Latest Posts</h2>
        {
            posts.length > 0 ? (
                <>
                    <div class="posts-grid">
                        {posts.map((post) => (
                            <PostCard
                                title={post.data.title}
                                description={post.data.description}
                                date={post.data.date}
                                author={post.data.author}
                                slug={post.slug}
                                headerImage={post.data.headerImage}
                                image={post.data.image}
                                tags={post.data.tags}
                            />
                        ))}
                    </div>
                    {totalPages > 1 && (
                        <Pagination
                            currentPage={safePage}
                            totalPages={totalPages}
                            prevUrl={prevUrl}
                            nextUrl={nextUrl}
                        />
                    )}
                </>
            ) : (
                <p class="empty">No posts yet — check back soon!</p>
            )
        }
    </section>
</Layout>

<style>
    .posts-section {
        max-width: 1100px;
        margin: 0 auto;
    }

    .section-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-secondary);
        margin-bottom: 1.75rem;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .empty {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    @media (max-width: 640px) {
        .posts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
