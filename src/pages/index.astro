---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import Search from "../components/Search.astro";

const POSTS_PER_PAGE = 6;

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam ?? "1") || 1);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const safePage = Math.min(currentPage, totalPages);

const posts = allPosts.slice(
    (safePage - 1) * POSTS_PER_PAGE,
    safePage * POSTS_PER_PAGE,
);

const prevUrl = safePage > 1 ? `/?page=${safePage - 1}#blog` : null;
const nextUrl = safePage < totalPages ? `/?page=${safePage + 1}#blog` : null;
---

<Layout>
    <!-- Hero -->
    <section class="hero">
        <div class="hero-badge">Personal Blog</div>
        <h1 class="hero-title">
            Thoughts &amp; ideas from<br />
            <span class="hero-accent">Christian Whitmer</span>
        </h1>
        <p class="hero-sub">
            Exploring web development, technology, and creative projects.
            Sharing what I learn along the way.
        </p>
        <div class="hero-search">
            <Search />
        </div>
    </section>

    <!-- Posts grid -->
    <section id="blog" class="posts-section">
        <h2 class="section-label">Latest Posts</h2>
        {
            posts.length > 0 ? (
                <>
                    <div class="posts-grid">
                        {posts.map((post) => (
                            <PostCard
                                title={post.data.title}
                                description={post.data.description}
                                date={post.data.date}
                                author={post.data.author}
                                slug={post.slug}
                                headerImage={post.data.headerImage}
                            />
                        ))}
                    </div>
                    {totalPages > 1 && (
                        <nav class="pagination" aria-label="Post pages">
                            <a
                                href={prevUrl ?? undefined}
                                class:list={[
                                    "page-btn",
                                    { disabled: !prevUrl },
                                ]}
                                aria-disabled={!prevUrl}
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m15 18-6-6 6-6" />
                                </svg>
                                Prev
                            </a>
                            <span class="page-info">
                                Page {safePage} of {totalPages}
                            </span>
                            <a
                                href={nextUrl ?? undefined}
                                class:list={[
                                    "page-btn",
                                    { disabled: !nextUrl },
                                ]}
                                aria-disabled={!nextUrl}
                            >
                                Next
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </a>
                        </nav>
                    )}
                </>
            ) : (
                <p class="empty">No posts yet — check back soon!</p>
            )
        }
    </section>
</Layout>

<style>
    /* ── Hero ── */
    .hero {
        max-width: 680px;
        margin: 0 auto 5rem;
        text-align: center;
        padding-top: 1.5rem;
    }

    .hero-badge {
        display: inline-block;
        padding: 0.275rem 0.875rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--accent-2);
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
        margin-bottom: 1.5rem;
    }

    .hero-title {
        font-size: clamp(2rem, 5.5vw, 3.25rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.13;
        color: var(--text);
        margin-bottom: 1.25rem;
    }

    .hero-accent {
        background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-sub {
        font-size: 1rem;
        color: var(--text-2);
        max-width: 440px;
        margin: 0 auto 2.5rem;
        line-height: 1.75;
    }

    .hero-search {
        max-width: 520px;
        margin: 0 auto;
    }

    /* ── Posts ── */
    .posts-section {
        max-width: 1100px;
        margin: 0 auto;
    }

    .section-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 1.75rem;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .empty {
        color: var(--text-3);
        font-size: 0.95rem;
    }

    /* ── Pagination ── */
    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 3rem;
    }

    .page-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg-card);
        color: var(--text-2);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition:
            color 0.15s,
            border-color 0.15s,
            background 0.15s;
    }

    .page-btn:not(.disabled):hover {
        color: var(--text);
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 8%, transparent);
    }

    .page-btn.disabled {
        opacity: 0.35;
        pointer-events: none;
    }

    .page-info {
        font-size: 0.85rem;
        color: var(--text-3);
        min-width: 90px;
        text-align: center;
    }

    @media (max-width: 640px) {
        .hero {
            margin-bottom: 3rem;
            padding-top: 0.5rem;
        }
        .posts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
