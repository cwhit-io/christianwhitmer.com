---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout>
	<section class="hero">
		<h1>Welcome to My Blog</h1>
		<p class="hero-subtitle">Exploring web development, technology, and creative projects</p>
	</section>

	<section id="blog" class="blog-section">
		<h2>Latest Posts</h2>
		<div class="posts-grid">
			{posts.map((post) => (
				<article class="post-card">
					<a href={`/blog/${post.slug}`} class="post-link">
						<h3>{post.data.title}</h3>
						<p class="post-description">{post.data.description}</p>
						<div class="post-meta">
							<span class="date">
								{post.data.date.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</span>
							<span class="author">by {post.data.author}</span>
						</div>
					</a>
				</article>
			))}
		</div>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 4rem;
	}

	.hero h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		color: #cbd5e1;
	}

	.blog-section h2 {
		margin-bottom: 2rem;
		font-size: 2rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.5rem;
	}

	.post-card {
		background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.6) 100%);
		border: 1px solid rgba(148, 163, 184, 0.1);
		border-radius: 0.75rem;
		padding: 1.5rem;
		transition: all 0.3s ease;
	}

	.post-card:hover {
		border-color: rgba(96, 165, 250, 0.3);
		background: linear-gradient(135deg, rgba(30, 41, 59, 1) 0%, rgba(15, 23, 42, 0.8) 100%);
		transform: translateY(-4px);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
	}

	.post-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.post-card h3 {
		margin-bottom: 0.75rem;
		color: #f1f5f9;
		font-size: 1.25rem;
		transition: color 0.2s ease;
	}

	.post-card:hover h3 {
		color: #60a5fa;
	}

	.post-description {
		color: #cbd5e1;
		margin-bottom: 1rem;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.post-meta {
		display: flex;
		gap: 1rem;
		font-size: 0.85rem;
		color: #94a3b8;
	}

	.date {
		font-weight: 500;
	}

	.author {
		color: #64748b;
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2rem;
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
