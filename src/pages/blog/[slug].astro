---
import { getCollection, getEntryBySlug } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getEntryBySlug("blog", slug);

if (!post) throw new Error(`Post not found: ${slug}`);

const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<Layout title={post.data.title} description={post.data.description}>
    <article class="article" data-pagefind-body>
        <header class="article-header">
            <h1 class="article-title" transition:name={`post-title-${slug}`}>
                {post.data.title}
            </h1>
            <p class="article-subtitle">{post.data.description}</p>
            <div class="article-meta">
                <span>By {post.data.author}</span>
                <span class="sep" aria-hidden="true">|</span>
                <time datetime={post.data.date.toISOString()}
                    >{formattedDate}</time
                >
                {
                    post.data.tags && post.data.tags.length > 0 && (
                        <>
                            <span class="sep" aria-hidden="true">
                                |
                            </span>
                            <span class="article-tags">
                                {post.data.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </span>
                        </>
                    )
                }
            </div>
        </header>

        {
            post.data.headerImage && (
                <div class="article-image">
                    <img
                        src={`/blog/${slug}/${post.data.headerImage}`}
                        alt={post.data.title}
                        loading="eager"
                        decoding="async"
                        transition:name={`post-image-${slug}`}
                    />
                </div>
            )
        }

        <div class="prose">
            <Content />
        </div>

        <footer class="article-footer" data-pagefind-ignore>
            <a href="/" class="back-btn">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"
                    ></path></svg
                >
                Back to all posts
            </a>
        </footer>
    </article>
</Layout>

<style>
    /* ── Article wrapper ── */
    .article {
        max-width: 70ch;
        margin: 0 auto;
    }

    /* ── Header ── */
    .article-header {
        margin-bottom: 2.5rem;
    }

    .article-title {
        font-family: var(--font-title);
        font-size: clamp(1.9rem, 3vw, 2.5rem);
        font-weight: 700;
        line-height: 1.15;
        color: var(--accent);
        margin-bottom: 0.75rem;
    }

    .article-subtitle {
        font-family: var(--font-body);
        font-size: clamp(1rem, 2vw, 1.15rem);
        font-style: italic;
        color: var(--text-secondary);
        line-height: 1.65;
        margin-bottom: 1.25rem;
    }

    .article-meta {
        font-family: var(--font-body);
        font-size: 0.82rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    .sep {
        opacity: 0.4;
    }

    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    .tag {
        display: inline-block;
        padding: 0.1em 0.5em;
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-1);
        font-size: 0.78rem;
        font-family: var(--font-code);
        color: var(--text-secondary);
    }

    /* ── Header image ── */
    .article-image {
        margin: 0 0 2.5rem;
        border-radius: var(--radius-2);
        overflow: hidden;
        border: 1px solid var(--border);
        aspect-ratio: 16 / 9;
        max-height: 400px;
    }

    .article-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* ── Prose reading measure ── */
    /* Global .prose :where(...) selectors in global.css handle body copy.   */
    /* Only article-specific layout concerns live here.                       */
    .prose {
        margin-top: 0;
    }

    /* ── Footer ── */
    .article-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--divider);
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color var(--trans-1);
    }

    .back-btn:hover {
        color: var(--accent);
    }
</style>
