        flex-wrap: wrap;
        gap: 0.5rem;
        max-width: 800px;
        margin: 0 auto;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 8px;
        box-shadow: var(--shadow);
        padding: 2rem;
    .sep {
        opacity: 0.4;
    }

        margin-bottom: 2.5rem;
        background: var(--header-bg);
        border-radius: 8px 8px 0 0;
        padding: 1.5rem 2rem 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        font-family: var(--font-title);
        font-size: 2.5em;
        font-weight: 700;
        line-height: 1.2;
        color: var(--accent);
        margin-bottom: 0.75rem;
        color: var(--accent);
        font-size: 0.78rem;
        font-weight: 500;
        font-family: var(--font-body);
        font-size: 1.1em;
        font-style: italic;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 1.25rem;
        margin: 0 0 2.5rem;
        border-radius: 14px;
        overflow: hidden;
        font-family: var(--font-body);
        font-size: 0.95em;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        border-bottom: 1px solid var(--subtle);
        padding-bottom: 0.5rem;
        height: 100%;
        object-fit: cover;
        display: block;
        width: 100%;
        margin: 1.5rem 0 2.5rem;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid var(--card-border);
        max-height: 400px;
        aspect-ratio: 16 / 9;
        background: var(--card-bg;
        color: var(--text-2);
    }

        font-family: var(--font-body);
        font-size: 1em;
        line-height: 1.6;
        color: var(--text-primary);
        letter-spacing: -0.01em;
        color: var(--accent);
        margin: 2.75rem 0 0.875rem;
        font-family: var(--font-title);
        font-size: 2em;
        font-weight: 700;
        color: var(--accent);
        margin: 2rem 0 1rem;
        line-height: 1.2;
        border-bottom: 1px solid var(--subtle);
        padding-bottom: 0.5rem;
        letter-spacing: -0.01em;
        color: var(--accent);
        margin: 2rem 0 0.625rem;
        font-family: var(--font-title);
        font-size: 1.5em;
        font-weight: 700;
        color: var(--accent);
        margin: 1.5rem 0 0.5rem;
        line-height: 1.2;
        color: var(--text);
        margin: 1.5rem 0 0.5rem;
    }
        font-family: var(--font-title);
        font-size: 1.1em;
        font-weight: 700;
        color: var(--text-primary);
        margin: 1rem 0 0.5rem;
    .prose :global(a) {
        color: var(--accent);
        text-decoration: underline;
        background: var(--subtle);
        border: 1px solid var(--card-border);
        padding: 0.15em 0.425em;
        border-radius: 5px;
        font-family: var(--font-code);
        font-size: 0.95em;
        color: var(--text-primary);
    }

    .prose :global(a:hover) {
        background: var(--subtle);
        border: 1px solid var(--card-border);
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
        margin: 1.5rem 0;
        box-shadow: var(--shadow);
        font-family: var(--font-code);
    .prose :global(ul),
    .prose :global(ol) {
        padding-left: 1.5rem;
        background: none;
        border: none;
        padding: 0;
        font-size: 0.95em;
        font-family: var(--font-code);
    }

    .prose :global(blockquote) {
        border-left: 3px solid var(--accent);
        padding: 0.75rem 0 0.75rem 1.25rem;
        margin: 1.75rem 0;
        color: var(--text-2);
        font-style: italic;
        background: color-mix(in srgb, var(--accent) 5%, transparent);
        border-radius: 0 8px 8px 0;
    }

    .prose :global(code) {
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        padding: 0.15em 0.425em;
        border-radius: 5px;
        font-family: var(--font-mono);
        font-size: 0.875em;
        color: var(--text);
    }

    .prose :global(pre) {
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        margin: 1.75rem 0;
        box-shadow: var(--shadow-sm);
        font-family: var(--font-mono);
    }

    .prose :global(pre code) {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.875rem;
        font-family: var(--font-mono);
    }

    .prose :global(img) {
        max-width: 100%;
        border-radius: 10px;
        border: 1px solid var(--border);
        margin: 1.75rem 0;
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
    }

    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1.75rem 0;
        font-size: 0.9rem;
    }

    .prose :global(th),
    .prose :global(td) {
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--border);
        text-align: left;
    }

    .prose :global(th) {
        background: var(--bg-subtle);
        font-weight: 600;
        color: var(--text);
    }

    /* ── Footer ── */
    .article-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-3);
        text-decoration: none;
        transition: color 0.15s;
    }

    .back-btn:hover {
        color: var(--text);
    }
</style>
