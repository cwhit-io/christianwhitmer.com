        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--accent);
        margin-bottom: 0.75rem;
    }

    .article-subtitle {
        font-family: var(--font-body);
        font-size: clamp(1.05rem, 2.2vw, 1.2rem);
        font-style: italic;
        color: var(--text-2);
        line-height: 1.65;
        margin-bottom: 1.25rem;
    }

    .article-meta {
