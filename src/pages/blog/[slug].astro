---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RecentPosts from "../../components/RecentPosts.astro";

export const prerender = true;

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts
        .filter((post) => !post.data.draft)
        .map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { slug } = Astro.params;

const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const heroSrc = post.data.image
    ? (post.data.image.startsWith('http') ? post.data.image : `https://${post.data.image}`)
    : post.data.headerImage
    ? `/blog/${slug}/${post.data.headerImage}`
    : null;

// Get all posts sorted by date for recent posts section
const allPosts = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
    title={post.data.title}
    description={post.data.description}
    ogImage={`/og/${slug}.png`}
>
    <article
        class="article"
        data-pagefind-body
        transition:name={`post-card-${slug}`}
    >
        <!-- Page header -->
        <header class="article-header">
            <h1 class="article-title" transition:name={`post-title-${slug}`}>
                {post.data.title}
            </h1>
            <p class="article-subtitle">{post.data.description}</p>
            <div class="article-meta">
                <time datetime={post.data.date.toISOString()}
                    >{formattedDate}</time
                >
                <span class="sep" aria-hidden="true">·</span>
                <span>By {post.data.author}</span>
                {
                    post.data.tags && post.data.tags.length > 0 && (
                        <>
                            <span class="sep" aria-hidden="true">
                                |
                            </span>
                            <span class="article-tags">
                                {post.data.tags.map((tag) => (
                                    <a href={`/tags/${encodeURIComponent(tag)}`} class="tag" data-astro-prefetch>{tag}</a>
                                ))}
                            </span>
                        </>
                    )
                }
            </div>
        </header>

        {heroSrc && (
                <div class="article-image">
                    <img
                        src={heroSrc}
                        alt={post.data.title}
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        transition:name={`post-image-${slug}`}
                    />
                </div>
            )}

        <div class="prose max-w-none">
            <Content />
        </div>

        <footer class="article-footer" data-pagefind-ignore>
            <a href="/" class="back-btn">← Back to all posts</a>
        </footer>

        <!-- Recent posts section -->
        <RecentPosts currentSlug={slug} posts={allPosts} limit={6} />
    </article>


</Layout>

<style>
    /* ── Container: flat, open — enhanced page feel ── */
    .article {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 1.5rem;
        background: var(--card-bg);
        border-radius: var(--radius-2);
        box-shadow: var(--shadow-1);
    }

    /* ── Header ── */
    .article-header {
        text-align: left;
        padding: 2.5rem 2rem 2rem;
        border-bottom: 2px solid var(--divider);
        margin-bottom: 2rem;
    }

    .article-title {
        font-family: var(--font-title);
        font-size: clamp(1.8rem, 5vw, 2.6rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.025em;
        background: linear-gradient(135deg, var(--accent) 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.75rem;
    }

    .article-subtitle {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-style: normal;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 60ch;
        margin: 0 0 1rem;
    }

    .article-meta {
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .sep {
        opacity: 0.4;
    }

    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        padding: 0.25em 0.75em;
        background: var(--tag-bg);
        border: 1px solid var(--tag-border);
        border-radius: var(--radius-2);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-family: var(--font-body);
        color: var(--tag-text);
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
        transition: all var(--trans-1);
    }

    @media (hover: hover) and (pointer: fine) {
        .tag:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 12%, transparent);
        }
    }

    /* ── Hero image — inline, demoted, constrained to prose width ── */
    .article-image {
        margin: 0 0 2rem;
        border-radius: var(--radius-1);
        overflow: hidden;
        max-width: 100%;
    }

    .article-image img {
        width: 100%;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    /* ── Content area ── */
    .prose {
        padding: 0 2rem;
        line-height: 1.8;
    }

    .prose p {
        margin-bottom: 1.25rem;
    }

    /* ── Footer ── */
    .article-footer {
        margin-top: 2rem;
        padding: 2rem;
        border-top: 1px solid var(--divider);
    }

    .back-btn {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color var(--trans-1);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .back-btn:hover {
        color: var(--accent);
    }

    @media (max-width: 640px) {
        .article {
            border-radius: 0;
            box-shadow: none;
            padding: 0;
        }

        .article-header {
            padding: 1.5rem 1rem 1rem;
            margin-bottom: 1.5rem;
        }

        .prose {
            padding: 0 1rem;
        }

        .article-footer {
            padding: 1.5rem 1rem;
        }
    }
</style>
