---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { slug } = Astro.params;

const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<Layout title={post.data.title} description={post.data.description}>
    <article
        class="article"
        data-pagefind-body
        transition:name={`post-card-${slug}`}
    >
        <!-- Page header — works with or without hero image -->
        <header class="article-header">
            <h1 class="article-title" transition:name={`post-title-${slug}`}>
                {post.data.title}
            </h1>
            <p class="article-subtitle">{post.data.description}</p>
            <div class="article-meta">
                <time datetime={post.data.date.toISOString()}
                    >{formattedDate}</time
                >
                <span class="sep" aria-hidden="true">·</span>
                <span>By {post.data.author}</span>
                {
                    post.data.tags && post.data.tags.length > 0 && (
                        <span class="article-tags">
                            {post.data.tags.map((tag) => (
                                <span class="tag">{tag}</span>
                            ))}
                        </span>
                    )
                }
            </div>
        </header>

        {
            post.data.headerImage && (
                <div class="article-image">
                    <img
                        src={`/blog/${slug}/${post.data.headerImage}`}
                        alt={post.data.title}
                        loading="eager"
                        decoding="async"
                        transition:name={`post-image-${slug}`}
                    />
                </div>
            )
        }

        <div class="prose max-w-none">
            <Content />
        </div>

        <footer class="article-footer" data-pagefind-ignore>
            <a href="/" class="back-btn">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                </svg>
                Back to all posts
            </a>
        </footer>
    </article>
</Layout>

<style>
    /* ── Container: flat, open — matches about page ── */
    .article {
        max-width: 800px;
        margin: 0 auto;
    }

    /* ── Header ── */
    .article-header {
        text-align: left;
        padding-top: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--divider);
        margin-bottom: 2rem;
    }

    .header-badge {
        /* removed — tags live in the meta line */
        display: none;
    }

    .article-title {
        font-family: var(--font-title);
        font-size: clamp(1.6rem, 4.5vw, 2.4rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.025em;
        background: linear-gradient(135deg, var(--accent) 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.75rem;
    }

    .article-subtitle {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-style: normal;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 60ch;
        margin: 0 0 1rem;
    }

    .article-meta {
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .sep {
        opacity: 0.4;
    }

    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        margin-left: 0.25rem;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        padding: 0.25em 0.75em;
        background: var(--tag-bg);
        border: 1px solid var(--tag-border);
        border-radius: var(--radius-2);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-family: var(--font-body);
        color: var(--tag-text);
        white-space: nowrap;
        cursor: default;
        user-select: none;
    }

    /* ── Hero image — inline, demoted, constrained to prose width ── */
    .article-image {
        margin: 0 0 2rem;
        border-radius: var(--radius-2);
        overflow: hidden;
    }

    .article-image img {
        width: 100%;
        height: 240px;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    /* ── Divider not needed — header already has border-bottom ── */
    .prose {
        padding-top: 0;
    }

    /* ── Footer ── */
    .article-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--divider);
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-1);
        background: transparent;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-decoration: none;
        transition:
            color var(--trans-1),
            background var(--trans-1),
            border-color var(--trans-1);
    }

    .back-btn svg {
        transition: transform var(--trans-1);
    }

    .back-btn:hover {
        color: var(--text-primary);
        background: var(--card-bg);
        border-color: var(--accent);
    }

    .back-btn:hover svg {
        transform: translateX(-3px);
    }
</style>
