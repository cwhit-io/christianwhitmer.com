---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts
        .filter((post) => !post.data.draft)
        .map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { slug } = Astro.params;

const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const heroSrc = post.data.image
    ? (post.data.image.startsWith('http') ? post.data.image : `https://${post.data.image}`)
    : post.data.headerImage
    ? `/blog/${slug}/${post.data.headerImage}`
    : null;
---

<Layout
    title={post.data.title}
    description={post.data.description}
    ogImage={`/og/${slug}.png`}
>
    <article
        class="article"
        data-pagefind-body
        transition:name={`post-card-${slug}`}
        id="reading-target"
    >
        <!-- Page header — works with or without hero image -->
        <header class="article-header">
            <div class="article-header-top">
                <div>
                    <h1 class="article-title" transition:name={`post-title-${slug}`}>
                        {post.data.title}
                    </h1>
                    <p class="article-subtitle">{post.data.description}</p>
                </div>
                <button class="reading-mode-btn" aria-label="Toggle reading mode" title="Toggle reading mode">
                    <span class="reading-icon">◊</span>
                </button>
            </div>
            <div class="article-meta">
                <time datetime={post.data.date.toISOString()}
                    >{formattedDate}</time
                >
                <span class="sep" aria-hidden="true">·</span>
                <span>By {post.data.author}</span>
                {
                    post.data.tags && post.data.tags.length > 0 && (
                        <>
                            <span class="sep" aria-hidden="true">
                                |
                            </span>
                            <span class="article-tags">
                                {post.data.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </span>
                        </>
                    )
                }
            </div>
        </header>

        {heroSrc && (
                <div class="article-image">
                    <img
                        src={heroSrc}
                        alt={post.data.title}
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                        transition:name={`post-image-${slug}`}
                    />
                </div>
            )}

        <div class="prose max-w-none">
            <Content />
        </div>

        <footer class="article-footer" data-pagefind-ignore>
            <a href="/" class="back-btn">← Back to all posts</a>
        </footer>
    </article>

    <script>
        // Initialize reading mode state from localStorage
        const readingModeBtn = document.querySelector('.reading-mode-btn');
        const article = document.getElementById('reading-target');
        
        function updateReadingMode(isActive: boolean) {
            if (isActive) {
                article?.setAttribute('data-reading-mode', '');
                readingModeBtn?.setAttribute('data-active', '');
            } else {
                article?.removeAttribute('data-reading-mode');
                readingModeBtn?.removeAttribute('data-active');
            }
            localStorage.setItem('reading-mode', isActive ? 'true' : 'false');
        }

        // Check for saved reading mode preference
        const savedReadingMode = localStorage.getItem('reading-mode') === 'true';
        if (savedReadingMode) {
            updateReadingMode(true);
        }

        // Toggle reading mode on button click
        readingModeBtn?.addEventListener('click', () => {
            const isCurrentlyActive = article?.hasAttribute('data-reading-mode');
            updateReadingMode(!isCurrentlyActive);
        });
    </script>
</Layout>

<style>
    /* ── Container: flat, open — enhanced page feel ── */
    .article {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 1.5rem;
        background: var(--card-bg);
        border-radius: var(--radius-2);
        box-shadow: var(--shadow-1);
    }

    /* ── Header with reading mode button ── */
    .article-header {
        text-align: left;
        padding: 2.5rem 2rem 2rem;
        border-bottom: 2px solid var(--divider);
        margin-bottom: 2rem;
        position: relative;
    }

    .article-header-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .article-header-top > div {
        flex: 1;
    }

    .reading-mode-btn {
        flex-shrink: 0;
        background: none;
        border: 2px solid var(--divider);
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-1);
        cursor: pointer;
        color: var(--text-secondary);
        font-size: 1rem;
        transition: all var(--trans-1);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        margin-top: 0.25rem;
    }

    .reading-mode-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 8%, transparent);
    }

    .reading-mode-btn[data-active] {
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 15%, transparent);
        color: var(--accent);
    }

    .reading-icon {
        display: block;
    }

    .header-badge {
        /* removed — tags live in the meta line */
        display: none;
    }

    .article-title {
        font-family: var(--font-title);
        font-size: clamp(1.8rem, 5vw, 2.6rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.025em;
        background: linear-gradient(135deg, var(--accent) 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.75rem;
    }

    .article-subtitle {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-style: normal;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 60ch;
        margin: 0 0 1rem;
    }

    .article-meta {
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .sep {
        opacity: 0.4;
    }

    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        padding: 0.25em 0.75em;
        background: var(--tag-bg);
        border: 1px solid var(--tag-border);
        border-radius: var(--radius-2);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-family: var(--font-body);
        color: var(--tag-text);
        white-space: nowrap;
        cursor: default;
        user-select: none;
    }

    /* ── Hero image — inline, demoted, constrained to prose width ── */
    .article-image {
        margin: 0 0 2rem;
        border-radius: var(--radius-1);
        overflow: hidden;
        max-width: 100%;
    }

    .article-image img {
        width: 100%;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    /* ── Content area ── */
    .prose {
        padding: 0 2rem;
        line-height: 1.8;
    }

    .prose p {
        margin-bottom: 1.25rem;
    }

    /* ── Footer ── */
    .article-footer {
        margin-top: 2rem;
        padding: 2rem;
        border-top: 1px solid var(--divider);
    }

    .back-btn {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color var(--trans-1);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .back-btn:hover {
        color: var(--accent);
    }

    /* ──────────── READING MODE STYLES ──────────────────────────────────────── */

    /* Reading mode: sepia tone and typography focus */
    .article[data-reading-mode] {
        --page-bg: #f5ede0;
        --card-bg: #faf7f2;
        --text-primary: #4a4540;
        --text-secondary: #6b6360;
        --divider: #e8dcc4;
        --border: #e8dcc4;
        --shadow-1: 0 1px 3px rgba(0, 0, 0, .06);
        
        filter: sepia(0.1) hue-rotate(0deg);
    }

    /* Reading mode: hide images */
    .article[data-reading-mode] .article-image {
        display: none;
    }

    .article[data-reading-mode] .reading-mode-btn {
        border-color: var(--text-secondary);
        color: var(--text-primary);
    }

    .article[data-reading-mode] .reading-mode-btn[data-active] {
        border-color: var(--text-primary);
        background: color-mix(in srgb, var(--text-primary) 10%, transparent);
        color: var(--text-primary);
    }

    /* Improve readability in reading mode */
    .article[data-reading-mode] .prose {
        font-size: 1.05rem;
        line-height: 1.9;
        letter-spacing: 0.3px;
    }

    .article[data-reading-mode] h1,
    .article[data-reading-mode] h2,
    .article[data-reading-mode] h3,
    .article[data-reading-mode] h4,
    .article[data-reading-mode] h5,
    .article[data-reading-mode] h6 {
        color: var(--text-primary);
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }

    /* Subtle styling for code blocks in reading mode */
    .article[data-reading-mode] code {
        background: color-mix(in srgb, #000 5%, var(--card-bg));
        border-radius: var(--radius-1);
        padding: 0.1em 0.4em;
        font-size: 0.9em;
    }

    .article[data-reading-mode] pre {
        background: color-mix(in srgb, #000 3%, var(--card-bg));
        border-left: 3px solid color-mix(in srgb, #000 15%, var(--card-bg));
    }

    /* Hide inline images in reading mode */
    .article[data-reading-mode] img:not(.article-image img) {
        display: none;
    }

    @media (max-width: 640px) {
        .article {
            border-radius: 0;
            box-shadow: none;
            padding: 0;
        }

        .article-header {
            padding: 1.5rem 1rem 1rem;
            margin-bottom: 1.5rem;
        }

        .article-header-top {
            flex-direction: column;
            gap: 0.75rem;
        }

        .reading-mode-btn {
            align-self: flex-start;
        }

        .prose {
            padding: 0 1rem;
        }

        .article-footer {
            padding: 1.5rem 1rem;
        }
    }
</style>
