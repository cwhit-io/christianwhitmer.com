---
import { getCollection, getEntryBySlug } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
const posts = await getCollection('blog');
return posts.map(post => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getEntryBySlug('blog', slug);

if (!post) throw new Error(`Post not found: ${slug}`);

const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('en-US', {
year: 'numeric',
month: 'long',
day: 'numeric',
});
---

<Layout title={post.data.title} description={post.data.description}>
<article class="article">

<header class="article-header">
<a href="/" class="back">
<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
All posts
</a>

<div class="article-meta">
<time datetime={post.data.date.toISOString()}>{formattedDate}</time>
<span class="sep" aria-hidden="true">·</span>
<span>{post.data.author}</span>
</div>

<h1 class="article-title">{post.data.title}</h1>
<p class="article-desc">{post.data.description}</p>
</header>

{post.data.headerImage && (
<div class="article-image">
<img
src={`/blog/${slug}/${post.data.headerImage}`}
alt={post.data.title}
loading="eager"
decoding="async"
/>
</div>
)}

<div class="prose" data-pagefind-body>
<Content />
</div>

<footer class="article-footer">
<a href="/" class="back-btn">
<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
Back to all posts
</a>
</footer>

</article>
</Layout>

<style>
.article {
max-width: 720px;
margin: 0 auto;
}

/* Back link */
.back {
display: inline-flex;
align-items: center;
gap: 0.375rem;
font-size: 0.82rem;
font-weight: 500;
color: var(--text-3);
text-decoration: none;
margin-bottom: 2.5rem;
padding: 0.35rem 0.7rem;
border-radius: 6px;
margin-left: -0.7rem;
border: 1px solid transparent;
transition: color 0.15s, background 0.15s, border-color 0.15s;
}

.back:hover {
color: var(--text);
background: var(--border);
border-color: var(--border);
}

/* Header */
.article-meta {
font-size: 0.82rem;
color: var(--text-3);
display: flex;
align-items: center;
gap: 0.5rem;
margin-bottom: 0.875rem;
}

.sep { opacity: 0.4; }

.article-title {
font-size: clamp(1.75rem, 4.5vw, 2.75rem);
font-weight: 800;
letter-spacing: -0.04em;
line-height: 1.13;
color: var(--text);
margin-bottom: 1rem;
}

.article-desc {
font-size: 1.05rem;
color: var(--text-2);
line-height: 1.65;
padding-bottom: 2.5rem;
margin-bottom: 0;
border-bottom: 1px solid var(--border);
}

/* Hero image */
.article-image {
margin: 2.5rem 0;
border-radius: 14px;
overflow: hidden;
border: 1px solid var(--border);
aspect-ratio: 16 / 9;
background: var(--bg-subtle);
}

.article-image img {
width: 100%;
height: 100%;
object-fit: cover;
}

/* ── Prose ── */
.prose {
font-size: 1rem;
line-height: 1.85;
color: var(--text-2);
margin-top: 2.5rem;
}

.prose :global(h2) {
font-size: 1.45rem;
font-weight: 700;
letter-spacing: -0.025em;
color: var(--text);
margin: 2.75rem 0 0.875rem;
padding-bottom: 0.5rem;
border-bottom: 1px solid var(--border);
}

.prose :global(h3) {
font-size: 1.15rem;
font-weight: 700;
letter-spacing: -0.02em;
color: var(--text);
margin: 2rem 0 0.625rem;
}

.prose :global(h4) {
font-size: 1rem;
font-weight: 700;
color: var(--text);
margin: 1.5rem 0 0.5rem;
}

.prose :global(p) {
margin-bottom: 1.5rem;
}

.prose :global(a) {
color: var(--accent-2);
text-decoration: underline;
text-decoration-color: color-mix(in srgb, var(--accent-2) 35%, transparent);
text-underline-offset: 3px;
transition: text-decoration-color 0.15s;
}

.prose :global(a:hover) {
text-decoration-color: var(--accent-2);
}

.prose :global(strong) { color: var(--text); font-weight: 650; }

.prose :global(ul),
.prose :global(ol) {
padding-left: 1.5rem;
margin-bottom: 1.5rem;
}

.prose :global(li) { margin-bottom: 0.4rem; }

.prose :global(blockquote) {
border-left: 3px solid var(--accent);
padding: 0.75rem 0 0.75rem 1.25rem;
margin: 1.75rem 0;
color: var(--text-2);
font-style: italic;
background: color-mix(in srgb, var(--accent) 5%, transparent);
border-radius: 0 8px 8px 0;
}

.prose :global(code) {
background: var(--bg-subtle);
border: 1px solid var(--border);
padding: 0.15em 0.425em;
border-radius: 5px;
font-family: 'Fira Code', 'Cascadia Code', 'Monaco', monospace;
font-size: 0.875em;
color: var(--text);
}

.prose :global(pre) {
background: var(--bg-subtle);
border: 1px solid var(--border);
border-radius: 12px;
padding: 1.25rem 1.5rem;
overflow-x: auto;
margin: 1.75rem 0;
box-shadow: var(--shadow-sm);
}

.prose :global(pre code) {
background: none;
border: none;
padding: 0;
font-size: 0.875rem;
}

.prose :global(img) {
max-width: 100%;
border-radius: 10px;
border: 1px solid var(--border);
margin: 1.75rem 0;
}

.prose :global(hr) {
border: none;
border-top: 1px solid var(--border);
margin: 2.5rem 0;
}

.prose :global(table) {
width: 100%;
border-collapse: collapse;
margin: 1.75rem 0;
font-size: 0.9rem;
}

.prose :global(th),
.prose :global(td) {
padding: 0.625rem 0.875rem;
border: 1px solid var(--border);
text-align: left;
}

.prose :global(th) {
background: var(--bg-subtle);
font-weight: 600;
color: var(--text);
}

/* Footer */
.article-footer {
margin-top: 4rem;
padding-top: 2rem;
border-top: 1px solid var(--border);
}

.back-btn {
display: inline-flex;
align-items: center;
gap: 0.4rem;
font-size: 0.875rem;
font-weight: 600;
color: var(--text-3);
text-decoration: none;
transition: color 0.15s;
}

.back-btn:hover { color: var(--text); }
</style>
