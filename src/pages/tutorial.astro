---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout
    title="How to Use This Site"
    description="A quick guide to navigating ChristianWhitmer.com — finding posts, searching, subscribing, and more."
>
    <div class="tutorial">
        <div class="hero">
            <div class="hero-badge">Site Guide</div>
            <h1 class="hero-title">
                How to Use <span class="hero-accent">This Site</span>
            </h1>
            <p class="hero-subtitle">
                A quick tour of everything ChristianWhitmer.com has to offer —
                from finding the right post to subscribing to new content.
            </p>
        </div>

        <div class="content" data-pagefind-body>

            <!-- Quick nav -->
            <nav class="toc" aria-label="Page contents">
                <p class="toc-label">On this page</p>
                <ol>
                    <li><a href="#browsing">Browsing Posts</a></li>
                    <li><a href="#searching">Searching</a></li>
                    <li><a href="#reading">Reading a Post</a></li>
                    <li><a href="#rss">RSS / Feed Subscription</a></li>
                    <li><a href="#theme">Light &amp; Dark Mode</a></li>
                    <li><a href="#about">About the Author</a></li>
                </ol>
            </nav>

            <!-- Section 1 -->
            <section class="section" id="browsing">
                <h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                        <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                        <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                        <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                        <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                    </svg>
                    Browsing Posts
                </h2>

                <p>
                    The <a href="/">home page</a> shows the latest posts in a card
                    grid, sorted newest-first. Each card shows the post title, a
                    short description, and the date it was published.
                </p>

                <div class="tip-card">
                    <span class="tip-label">Tip</span>
                    <p>
                        If there are more than six posts, pagination links appear
                        at the bottom of the grid. Use the <strong>Previous</strong>
                        and <strong>Next</strong> buttons — or jump straight to
                        <a href="/#blog">/#blog</a> to skip the hero area.
                    </p>
                </div>

                <p>
                    Click any card to open the full post. Use your browser's back
                    button or the site logo in the top-left corner to return to the
                    home page.
                </p>
            </section>

            <!-- Section 2 -->
            <section class="section" id="searching">
                <h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    Searching
                </h2>

                <p>
                    Every page has a <strong>search icon</strong> (🔍) in the top
                    navigation bar. Click it to open the search dialog, then start
                    typing. Results appear instantly as you type, powered by
                    <a href="https://pagefind.app" target="_blank" rel="noopener noreferrer">Pagefind</a> —
                    a fast, fully local search index built into the site.
                </p>

                <ol class="step-list">
                    <li>Click the search icon in the header.</li>
                    <li>Type a keyword, topic, or phrase.</li>
                    <li>Click any result to jump to that post.</li>
                    <li>Press <kbd>Esc</kbd> or the ✕ button to close.</li>
                </ol>

                <p>
                    No data leaves your browser — the entire search index is
                    downloaded once and runs locally.
                </p>
            </section>

            <!-- Section 3 -->
            <section class="section" id="reading">
                <h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                    Reading a Post
                </h2>

                <p>
                    Each post page includes the full article text, a header image
                    (when available), the publish date, and author info. The content
                    is formatted for comfortable reading on any screen size.
                </p>

                <p>
                    Code examples are displayed in a monospace font with syntax
                    highlighting so they're easy to copy and use. Long posts
                    include section headings you can use to jump around.
                </p>

                <div class="tip-card">
                    <span class="tip-label">Tip</span>
                    <p>
                        Each post has its own shareable URL in the format
                        <code>/blog/post-slug</code>. Copy the address bar to share a
                        specific article.
                    </p>
                </div>
            </section>

            <!-- Section 4 -->
            <section class="section" id="rss">
                <h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"></path>
                    </svg>
                    RSS / Feed Subscription
                </h2>

                <p>
                    The site publishes a standard <strong>RSS feed</strong> so you
                    can follow new posts in any feed reader — Feedly, NetNewsWire,
                    Reeder, Inoreader, and many others support it.
                </p>

                <ol class="step-list">
                    <li>
                        Open your RSS reader and choose "Add feed" (or similar).
                    </li>
                    <li>
                        Paste the feed URL:
                        <code class="block-code">https://christianwhitmer.com/rss.xml</code>
                    </li>
                    <li>
                        Save it — new posts will appear automatically.
                    </li>
                </ol>

                <p>
                    You can also click the <strong>RSS icon</strong> in the site
                    header to open the raw feed, then copy its URL from your browser
                    address bar.
                </p>
            </section>

            <!-- Section 5 -->
            <section class="section" id="theme">
                <h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                    </svg>
                    Light &amp; Dark Mode
                </h2>

                <p>
                    The <strong>theme toggle</strong> button (sun / moon icon) is in
                    the top-right corner of the header. Click it to switch between
                    light and dark mode. Your preference is saved in the browser and
                    remembered on your next visit.
                </p>

                <p>
                    If you haven't set a preference, the site defaults to whichever
                    mode your operating system is currently using.
                </p>
            </section>

            <!-- Section 6 -->
            <section class="section" id="about">
                <h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
                    </svg>
                    About the Author
                </h2>

                <p>
                    Visit the <a href="/about">About page</a> to learn more about
                    Christian Whitmer — his background in church technology and
                    ministry, what topics he writes about, and why this site exists.
                </p>
            </section>

            <!-- Footer CTA -->
            <section class="section final-section">
                <h2>Still Have Questions?</h2>
                <p>
                    If you can't find what you're looking for, use the search tool
                    at the top of any page — it indexes the full text of every post.
                    You can also browse the <a href="/#blog">full post list</a> on
                    the home page.
                </p>
            </section>

        </div>
    </div>
</Layout>

<style>
    .tutorial {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 1.25rem 4rem;
    }

    /* Hero */
    .hero {
        text-align: center;
        margin-bottom: 3rem;
        padding-top: 1.5rem;
    }

    .hero-badge {
        display: inline-block;
        padding: 0.275rem 0.875rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
        margin-bottom: 1.25rem;
    }

    .hero-title {
        font-size: clamp(1.75rem, 5vw, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.15;
        color: var(--text-primary);
        margin: 0;
    }

    .hero-accent {
        background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-subtitle {
        max-width: 620px;
        margin: 1rem auto 0;
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.7;
    }

    /* Table of contents */
    .toc {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2.5rem;
    }

    .toc-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 0.75rem;
    }

    .toc ol {
        margin: 0;
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .toc li {
        font-size: 0.9rem;
    }

    .toc a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 160ms;
    }

    .toc a:hover {
        color: var(--accent);
    }

    /* Sections */
    .section {
        margin-bottom: 2.75rem;
        scroll-margin-top: 5rem;
    }

    .section h2 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--text-primary);
        margin-bottom: 0.875rem;
        padding-bottom: 0.625rem;
        border-bottom: 1px solid var(--border);
    }

    .section h2 svg {
        color: var(--accent);
        flex-shrink: 0;
    }

    .section p {
        font-size: 0.975rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin: 0 0 0.875rem;
    }

    .section a {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .section a:hover {
        text-decoration: none;
    }

    /* Tip card */
    .tip-card {
        background: color-mix(in srgb, var(--accent) 6%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin: 0 0 1rem;
    }

    .tip-label {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.4rem;
    }

    .tip-card p {
        margin: 0;
        font-size: 0.9rem;
    }

    /* Step list */
    .step-list {
        margin: 0 0 1rem 1.25rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .step-list li {
        font-size: 0.975rem;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    /* Inline code */
    code {
        font-family: var(--font-code);
        font-size: 0.85em;
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1em 0.4em;
        color: var(--text-primary);
    }

    .block-code {
        display: block;
        margin: 0.5rem 0;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        word-break: break-all;
    }

    kbd {
        font-family: var(--font-code);
        font-size: 0.8em;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-bottom-width: 2px;
        border-radius: 5px;
        padding: 0.1em 0.45em;
        color: var(--text-primary);
    }

    /* Final section */
    .final-section {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem;
    }

    .final-section h2 {
        border-bottom-color: var(--border);
    }
</style>
