---
import PostCard from "./PostCard.astro";

interface Props {
	currentSlug: string;
	posts: Array<{
		slug: string;
		data: {
			title: string;
			description: string;
			date: Date;
			author: string;
			image?: string;
			headerImage?: string;
		};
	}>;
	limit?: number;
}

const { currentSlug, posts, limit = 3 } = Astro.props;

// Filter out the current post and limit to N posts
const recentPosts = posts
	.filter((post) => post.slug !== currentSlug)
	.slice(0, limit);
---

<aside class="recent-posts">
	<h3 class="recent-posts-title">More Stories</h3>
	<div class="recent-posts-grid">
		{recentPosts.map((post) => (
			<PostCard
				title={post.data.title}
				description={post.data.description}
				date={post.data.date}
				author={post.data.author}
				slug={post.slug}
				headerImage={post.data.headerImage}
				image={post.data.image}
			/>
		))}
	</div>
</aside>

<style>
	.recent-posts {
		max-width: 800px;
		margin: 3rem auto 0;
		padding-top: 2rem;
		border-top: 2px solid var(--divider);
	}

	.recent-posts-title {
		font-family: var(--font-title);
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1.5rem;
	}

	.recent-posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
	}

	@media (max-width: 640px) {
		.recent-posts {
			margin: 2rem auto 0;
			padding-top: 1.5rem;
		}

		.recent-posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
