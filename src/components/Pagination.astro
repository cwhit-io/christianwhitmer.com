---
interface Props {
    currentPage: number;
    totalPages: number;
    prevUrl: string | null;
    nextUrl: string | null;
}

const { currentPage, totalPages, prevUrl, nextUrl } = Astro.props;
---

<nav class="pagination" aria-label="Post pages">
    <a
        href={prevUrl ?? undefined}
        class:list={["page-btn", { disabled: !prevUrl }]}
        aria-disabled={!prevUrl}
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="m15 18-6-6 6-6"></path>
        </svg>
        Prev
    </a>
    <span class="page-info">Page {currentPage} of {totalPages}</span>
    <a
        href={nextUrl ?? undefined}
        class:list={["page-btn", { disabled: !nextUrl }]}
        aria-disabled={!nextUrl}
    >
        Next
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="m9 18 6-6-6-6"></path>
        </svg>
    </a>
</nav>

<style>
    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 3rem;
    }

    .page-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--card-bg);
        color: var(--text-secondary);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition:
            color var(--trans-1),
            border-color var(--trans-1),
            background var(--trans-1);
    }

    .page-btn:not(.disabled):hover {
        color: var(--text-primary);
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 8%, transparent);
    }

    .page-btn.disabled {
        opacity: 0.35;
        pointer-events: none;
    }

    .page-info {
        font-size: 0.85rem;
        color: var(--text-secondary);
        min-width: 90px;
        text-align: center;
    }
</style>
