---
interface Props {
	title: string;
	description: string;
	date: Date;
	author: string;
	slug: string;
	headerImage?: string;
	image?: string;
}

const { title, description, date, author, slug, headerImage, image } = Astro.props;

const heroSrc = image
	? (image.startsWith('http') ? image : `https://${image}`)
	: headerImage
	? `/blog/${slug}/${headerImage}`
	: null;

const formattedDate = date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<article class="card" transition:name={`post-card-${slug}`}>
	<a href={`/blog/${slug}`} class="card-link" data-astro-prefetch>
		{
			heroSrc && (
				<div class="card-image">
					<img
						src={heroSrc}
						alt={title}
						loading="lazy"
						decoding="async"
						transition:name={`post-image-${slug}`}
					/>
				</div>
			)
		}
		<div class="card-body">
			<div class="card-meta">
				<time datetime={date.toISOString()}>{formattedDate}</time>
				<span class="sep" aria-hidden="true">·</span>
				<span>{author}</span>
			</div>
			<h2 class="card-title" transition:name={`post-title-${slug}`}>
				{title}
			</h2>
			<p class="card-desc">{description}</p>
			<span class="card-cta" aria-hidden="true">
				Read more
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="13"
					height="13"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</span>
		</div>
	</a>
</article>

<style>
	.card {
		background: var(--card-bg);
		border: 1px solid var(--border);
		border-radius: var(--radius-2);
		overflow: hidden;
		transition:
			transform var(--trans-card),
			box-shadow var(--trans-card),
			border-color var(--trans-card);
		box-shadow: var(--shadow-1);
	}

	@media (hover: hover) and (pointer: fine) {
		.card:hover {
			transform: translateY(-2px);
			box-shadow: var(--shadow-2);
			border-color: var(--accent);
			will-change: transform;
		}

		.card:hover .card-title {
			color: var(--accent);
		}

		.card:hover .card-cta {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

	.card-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--code-bg);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-body {
		padding: 1.375rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.card-meta {
		font-size: 0.775rem;
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-bottom: 0.125rem;
	}

	.sep {
		opacity: 0.4;
	}

	.card-title {
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.35;
		color: var(--text-primary);
		font-family: var(--font-title);
		transition: color var(--trans-1);
	}

	.card-desc {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-top: 0.25rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		margin-top: 0.625rem;
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity var(--trans-1),
			transform var(--trans-1);
	}
</style>
