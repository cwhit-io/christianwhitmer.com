---
interface Props {
	title: string;
	description: string;
	date: Date;
	author: string;
	slug: string;
	headerImage?: string;
}

const { title, description, date, author, slug, headerImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<article class="card">
	<a href={`/blog/${slug}`} class="card-link" data-astro-prefetch>
		{headerImage && (
			<div class="card-image">
				<img
					src={`/blog/${slug}/${headerImage}`}
					alt={title}
					loading="lazy"
					decoding="async"
				/>
			</div>
		)}
		<div class="card-body">
			<div class="card-meta">
				<time datetime={date.toISOString()}>{formattedDate}</time>
				<span class="sep" aria-hidden="true">·</span>
				<span>{author}</span>
			</div>
			<h2 class="card-title">{title}</h2>
			<p class="card-desc">{description}</p>
			<span class="card-cta" aria-hidden="true">
				Read more
				<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 12h14"/>
					<path d="m12 5 7 7-7 7"/>
				</svg>
			</span>
		</div>
	</a>
</article>

<style>
	.card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
		box-shadow: var(--shadow-sm);
		will-change: transform;
	}

	.card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-lg);
		border-color: var(--border-hover);
	}

	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

	.card-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--bg-subtle);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.card:hover .card-image img {
		transform: scale(1.05);
	}

	.card-body {
		padding: 1.375rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.card-meta {
		font-size: 0.775rem;
		color: var(--text-3);
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-bottom: 0.125rem;
	}

	.sep { opacity: 0.4; }

	.card-title {
		font-size: 1.1rem;
		font-weight: 650;
		letter-spacing: -0.025em;
		line-height: 1.35;
		color: var(--text);
		transition: color 0.15s;
	}

	.card:hover .card-title {
		color: var(--accent-2);
	}

	.card-desc {
		font-size: 0.875rem;
		color: var(--text-2);
		line-height: 1.6;
		margin-top: 0.25rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-2);
		margin-top: 0.625rem;
		opacity: 0;
		transform: translateX(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.card:hover .card-cta {
		opacity: 1;
		transform: translateX(0);
	}
</style>
