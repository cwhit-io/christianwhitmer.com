---
// Pagefind UI is generated into /pagefind/ at build time.
// In dev mode the UI gracefully reports no results (no index exists yet).
---

<div id="pagefind-search" data-pagefind-ignore>
	<div id="search-container"></div>
	<div id="search-fallback">
		<input
			type="search"
			class="search-placeholder"
			placeholder="Search posts…"
			readonly
			aria-label="Search"
		/>
	</div>
</div>

<script is:inline>
	function initSearch() {
		const container = document.getElementById("search-container");
		const fallback = document.getElementById("search-fallback");
		if (!container) return;

		// Already mounted — skip
		if (container.children.length > 0) {
			if (fallback) fallback.hidden = true;
			return;
		}

		// Load pagefind-ui.css
		if (!document.querySelector('link[href="/pagefind/pagefind-ui.css"]')) {
			const link = document.createElement("link");
			link.rel = "stylesheet";
			link.href = "/pagefind/pagefind-ui.css";
			document.head.appendChild(link);
		}

		// Load pagefind-ui.js as a classic script, then instantiate
		const script = document.createElement("script");
		script.src = "/pagefind/pagefind-ui.js";
		script.onload = function () {
			if (typeof window.PagefindUI !== "undefined") {
				new window.PagefindUI({
					element: "#search-container",
					showSubResults: true,
					resetStyles: false,
					showImages: false,
				});
				if (fallback) fallback.hidden = true;
			} else {
				if (fallback) fallback.hidden = false;
			}
		};
		script.onerror = function () {
			if (fallback) fallback.hidden = false;
		};
		document.head.appendChild(script);
	}

	document.addEventListener("DOMContentLoaded", initSearch);
	document.addEventListener("astro:after-swap", initSearch);
</script>

<style>
	#pagefind-search {
		width: 100%;
	}

	.search-placeholder {
		width: 100%;
		padding: 0.65rem 1rem;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-card);
		color: var(--text-3);
		font-family: "Inter", system-ui, sans-serif;
		font-size: 0.95rem;
		cursor: text;
		box-sizing: border-box;
	}

	/* Override Pagefind input to match site theme */
	:global(.pagefind-ui__search-input) {
		background: var(--bg-card) !important;
		color: var(--text) !important;
		border-color: var(--border) !important;
		font-family: "Inter", system-ui, sans-serif !important;
		transition:
			border-color 0.15s,
			box-shadow 0.15s !important;
	}

	:global(.pagefind-ui__search-input:focus) {
		border-color: var(--accent) !important;
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent) !important;
		outline: none !important;
	}

	:global(.pagefind-ui__search-clear) {
		color: var(--text-3) !important;
	}

	:global(.pagefind-ui__result) {
		border-color: var(--border) !important;
		background: var(--bg-card) !important;
		border-radius: 10px !important;
	}

	:global(.pagefind-ui__result-title) {
		color: var(--text) !important;
	}

	:global(.pagefind-ui__result-excerpt) {
		color: var(--text-2) !important;
	}

	:global(.pagefind-ui mark) {
		background: color-mix(
			in srgb,
			var(--accent) 20%,
			transparent
		) !important;
		color: var(--accent-2) !important;
		border-radius: 2px;
	}
</style>
