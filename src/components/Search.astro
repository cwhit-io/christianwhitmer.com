---
// Pagefind UI is generated into /pagefind/ at build time.
// The search index only exists after a production build — in dev mode the UI will
// gracefully report no results.
---

<div id="pagefind-search" data-pagefind-ignore>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search-container"></div>
</div>

<script>
    // Dynamically import so it doesn't error in dev where the file doesn't exist
    async function initSearch() {
        try {
            // @ts-ignore — generated at build time
            const { PagefindUI } = await import('/pagefind/pagefind-ui.js');
            new PagefindUI({
                element: '#search-container',
                showSubResults: true,
                resetStyles: false,
            });
        } catch {
            const el = document.getElementById('search-container');
            if (el) el.textContent = 'Search is only available in production builds.';
        }
    }

    initSearch();
</script>
