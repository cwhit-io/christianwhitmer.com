---
import Search from "./Search.astro";
---

<header class="site-intro">
	<div class="site-intro-inner">
		<div class="site-intro-text">
			<h1 class="site-intro-name">Christian Whitmer</h1>
			<p class="site-intro-tagline">
				Thoughts on church technology, ministry &amp; the people behind it
			</p>
		</div>
		<div class="site-intro-search">
			<Search />
		</div>
	</div>
</header>

<style>
	.site-intro {
		max-width: 1100px;
		margin: 0 auto 2.5rem;
		padding: 2.5rem 0 2rem;
		border-bottom: 1px solid var(--divider);
	}

	.site-intro-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.site-intro-name {
		font-family: var(--font-title);
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		font-weight: 800;
		letter-spacing: -0.025em;
		color: var(--text-primary);
		margin-bottom: 0.35rem;
		line-height: 1.1;
	}

	.site-intro-tagline {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.5;
		max-width: 42ch;
	}

	.site-intro-search {
		flex-shrink: 0;
		width: 260px;
	}

	@media (max-width: 768px) {
		.site-intro {
			padding: 1.75rem 0 1.5rem;
			margin-bottom: 2rem;
		}

		.site-intro-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.site-intro-search {
			width: 100%;
		}
	}
</style>
