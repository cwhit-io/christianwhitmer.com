<div class="blog-intro">
	<span class="blog-intro-rule" aria-hidden="true"></span>
	<p class="blog-intro-text">
		Thoughts on church technology, ministry &amp; creativity
		&mdash; by <strong>Christian Whitmer</strong>
	</p>
	<span class="blog-intro-rule" aria-hidden="true"></span>
</div>

<style>
	.blog-intro {
		max-width: 1100px;
		margin: 0 auto 2.5rem;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 0 0.5rem;
	}

	.blog-intro-rule {
		flex: 1;
		height: 1px;
		background: var(--divider);
		display: block;
	}

	.blog-intro-text {
		flex-shrink: 0;
		font-size: 0.8rem;
		color: var(--text-secondary);
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.blog-intro-text strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	@media (max-width: 640px) {
		.blog-intro {
			margin-bottom: 2rem;
		}

		.blog-intro-text {
			white-space: normal;
			text-align: center;
		}
	}
</style>
