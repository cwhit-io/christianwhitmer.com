---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import avatar from "../assets/icon-3d.png";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Christian Whitmer",
	description = "Thoughts, projects, and updates on web development and technology.",
} = Astro.props;

const pageTitle =
	title === "Christian Whitmer" ? title : `${title} — Christian Whitmer`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Christian Whitmer" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Christian Whitmer's Blog"
			href="/rss.xml"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Roboto+Slab:wght@700;800&family=Source+Code+Pro:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<!-- Prevent flash of incorrect theme (runs synchronously before first paint) -->
		<script is:inline>
			(function () {
				var stored = localStorage.getItem("theme");
				var prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				var theme =
					stored === "dark" || stored === "light"
						? stored
						: prefersDark
							? "dark"
							: "light";
				document.documentElement.dataset.theme = theme;
			})();
			// Keep data-theme in sync across ViewTransitions page swaps
			document.addEventListener("astro:before-swap", function (e) {
				e.newDocument.documentElement.dataset.theme =
					document.documentElement.dataset.theme;
			});
		</script>
		<ViewTransitions />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="logo" aria-label="Christian Whitmer — home">
					<img
						src={avatar.src}
						alt=""
						class="logo-mark"
						width="34"
						height="34"
						aria-hidden="true"
					/>
					<span class="logo-text">Christian Whitmer</span>
				</a>
				<div class="nav-right">
					<ul class="nav-links" role="list">
						<li><a href="/">Home</a></li>
						<li><a href="/#blog">Blog</a></li>
						<li><a href="/about">About</a></li>
					</ul>
					<ThemeToggle />
					<button
						class="nav-burger"
						id="nav-burger"
						aria-label="Open navigation menu"
						aria-expanded="false"
						aria-controls="nav-mobile"
					>
						<span class="burger-bar"></span>
						<span class="burger-bar"></span>
						<span class="burger-bar"></span>
					</button>
				</div>
			</nav>
			<div class="nav-mobile" id="nav-mobile" aria-hidden="true">
				<ul role="list">
					<li><a href="/">Home</a></li>
					<li><a href="/#blog">Blog</a></li>
					<li><a href="/about">About</a></li>
				</ul>
			</div>
		</header>

		<script is:inline>
			const burger = document.getElementById("nav-burger");
			const mobileMenu = document.getElementById("nav-mobile");
			function toggleMenu(open) {
				burger.setAttribute("aria-expanded", String(open));
				mobileMenu.setAttribute("aria-hidden", String(!open));
				burger.classList.toggle("is-open", open);
				mobileMenu.classList.toggle("is-open", open);
			}
			burger.addEventListener("click", () => {
				const isOpen = burger.getAttribute("aria-expanded") === "true";
				toggleMenu(!isOpen);
			});
			// Close on link click
			mobileMenu
				.querySelectorAll("a")
				.forEach((a) =>
					a.addEventListener("click", () => toggleMenu(false)),
				);
			// Close on page nav (ViewTransitions)
			document.addEventListener("astro:after-swap", () =>
				toggleMenu(false),
			);
		</script>

		<main class="main" id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<p>
					&copy; {new Date().getFullYear()} Christian Whitmer. All rights
					reserved.
				</p>
				<div class="footer-links">
					<a href="/rss.xml">RSS</a>
					<a href="/sitemap-index.xml">Sitemap</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	/* ── Site header — always-dark glassy panel ── */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--header-bg);
		border-bottom: 1px solid var(--subtle);
		backdrop-filter: blur(24px) saturate(150%);
		-webkit-backdrop-filter: blur(24px) saturate(150%);
		box-shadow: var(--shadow);
		transition:
			background 0.3s ease,
			border-color 0.3s ease;
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-body);
	}

	/* ── Logo ── */
	.logo {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
		flex-shrink: 0;
		transition: opacity 0.2s;
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo-mark {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent);
	}

	.logo-text {
		font-family: "Fraunces", Georgia, serif;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1;
		background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	/* ── Desktop nav links ── */
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 0.125rem;
	}

	.nav-links a {
		display: block;
		padding: 0.375rem 0.8rem;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition:
			color var(--trans-1),
			background var(--trans-1);
	}

	.nav-links a:hover {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}

	/* ── Hamburger button ── */
	.nav-burger {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 36px;
		height: 36px;
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
		border-radius: 8px;
		cursor: pointer;
		padding: 0;
		transition:
			background var(--trans-1),
			border-color var(--trans-1);
		flex-shrink: 0;
	}

	.nav-burger:hover {
		background: color-mix(in srgb, var(--accent) 20%, transparent);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}

	.burger-bar {
		display: block;
		width: 16px;
		height: 2px;
		background: var(--text-primary);
		border-radius: 2px;
		transition:
			transform var(--trans-1),
			opacity var(--trans-1);
	}

	/* Animate burger → X */
	.nav-burger.is-open .burger-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.nav-burger.is-open .burger-bar:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}

	.nav-burger.is-open .burger-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* ── Mobile dropdown menu ── */
	.nav-mobile {
		display: none;
		overflow: hidden;
		max-height: 0;
		transition:
			max-height 0.25s ease,
			padding 0.25s ease;
		border-top: 1px solid var(--divider);
	}

	.nav-mobile.is-open {
		max-height: 200px;
		padding: 0.5rem 0;
	}

	.nav-mobile ul {
		list-style: none;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.nav-mobile a {
		display: block;
		padding: 0.625rem 0.875rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition:
			color var(--trans-1),
			background var(--trans-1);
	}

	.nav-mobile a:hover {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}

	/* ── Main & Footer ── */
	.main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		min-height: calc(100dvh - 64px - 60px);
	}

	.site-footer {
		border-top: 1px solid var(--divider);
		background: var(--header-bg);
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.125rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		font-size: 0.82rem;
		color: var(--text-3);
	}

	.footer-links {
		display: flex;
		gap: 1.25rem;
	}

	.footer-links a {
		color: var(--text-3);
		text-decoration: none;
		transition: color 0.15s;
	}

	.footer-links a:hover {
		color: var(--accent-2);
	}

	/* ── ThemeToggle override — scoped to header context ── */
	:global(.site-header #theme-toggle) {
		border-color: color-mix(in srgb, var(--accent) 22%, transparent);
		color: var(--text-secondary);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}

	:global(.site-header #theme-toggle:hover) {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}

	/* ── Mobile breakpoint ── */
	@media (max-width: 640px) {
		.nav-links {
			display: none;
		}

		.nav-burger {
			display: flex;
		}

		.nav-mobile {
			display: block;
		}

		.main {
			padding: 2rem 1rem;
		}

		.footer-inner {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
