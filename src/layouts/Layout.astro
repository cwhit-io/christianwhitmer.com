---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Christian Whitmer | Blog</title>
		<meta name="description" content="The personal blog of Christian Whitmer. Thoughts, projects, and updates." />
		<meta name="author" content="Christian Whitmer" />
		<link rel="alternate" type="application/rss+xml" title="Christian Whitmer's Blog" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="header">
			<nav class="nav-container">
				<div class="logo">
					<a href="/">
						<h1>Christian Whitmer</h1>
					</a>
				</div>
				<ul class="nav-links">
					<li><a href="/">Home</a></li>
					<li><a href="#blog">Blog</a></li>
					<li><a href="#about">About</a></li>
				</ul>
			</nav>
		</header>

		<main class="main-content">
			<slot />
		</main>

		<footer class="footer">
			<div class="footer-content">
				<p>&copy; {new Date().getFullYear()} Christian Whitmer. All rights reserved.</p>
				<p class="tagline">Thoughts, projects, and updates on web development and technology.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html,
	body {
		width: 100%;
		height: 100%;
	}

	body {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
		color: #e2e8f0;
		line-height: 1.6;
		overflow-x: hidden;
	}

	.header {
		background: rgba(15, 23, 42, 0.95);
		border-bottom: 1px solid rgba(148, 163, 184, 0.1);
		padding: 1.5rem 0;
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(10px);
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo a {
		text-decoration: none;
		color: #e2e8f0;
		transition: color 0.3s ease;
	}

	.logo a:hover {
		color: #60a5fa;
	}

	.logo h1 {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.5px;
	}

	.nav-links {
		list-style: none;
		display: flex;
		gap: 2rem;
	}

	.nav-links a {
		color: #cbd5e1;
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
		font-size: 0.95rem;
	}

	.nav-links a:hover {
		color: #60a5fa;
	}

	.main-content {
		max-width: 900px;
		margin: 3rem auto;
		padding: 0 1.5rem;
		min-height: calc(100vh - 200px);
	}

	.footer {
		background: rgba(15, 23, 42, 0.95);
		border-top: 1px solid rgba(148, 163, 184, 0.1);
		padding: 2rem 1.5rem;
		margin-top: 4rem;
		text-align: center;
	}

	.footer-content p {
		color: #94a3b8;
		font-size: 0.9rem;
		margin: 0.5rem 0;
	}

	.tagline {
		color: #64748b;
		font-style: italic;
	}

	a {
		color: #60a5fa;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: #93c5fd;
	}

	h1, h2, h3, h4, h5, h6 {
		font-weight: 700;
		line-height: 1.2;
	}

	h1 {
		font-size: 2.5rem;
	}

	h2 {
		font-size: 1.875rem;
	}

	h3 {
		font-size: 1.5rem;
	}

	p {
		margin: 1rem 0;
	}

	code {
		background: rgba(100, 116, 139, 0.3);
		padding: 0.2rem 0.4rem;
		border-radius: 0.25rem;
		font-family: 'Monaco', 'Menlo', monospace;
		font-size: 0.9rem;
	}

	pre {
		background: rgba(15, 23, 42, 0.8);
		padding: 1.5rem;
		border-radius: 0.5rem;
		overflow-x: auto;
		border: 1px solid rgba(148, 163, 184, 0.1);
		margin: 1rem 0;
	}

	blockquote {
		border-left: 4px solid #60a5fa;
		padding-left: 1rem;
		margin: 1.5rem 0;
		color: #cbd5e1;
		font-style: italic;
	}

	@media (max-width: 768px) {
		.nav-links {
			gap: 1rem;
		}
		
		.logo h1 {
			font-size: 1.25rem;
		}
		
		h1 {
			font-size: 1.875rem;
		}
		
		.main-content {
			margin: 1.5rem auto;
		}
	}
</style>
