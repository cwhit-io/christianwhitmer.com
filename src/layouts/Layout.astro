---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import avatar from "../assets/icon-3d.png";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Christian Whitmer",
	description = "Thoughts, projects, and updates on web development and technology.",
} = Astro.props;

const pageTitle =
	title === "Christian Whitmer" ? title : `${title} — Christian Whitmer`;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Christian Whitmer" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Christian Whitmer's Blog"
			href="/rss.xml"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Roboto+Slab:wght@700;800&family=Source+Code+Pro:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<!-- Prevent flash of incorrect theme (runs synchronously before first paint) -->
		<script is:inline>
			(function () {
				var stored = localStorage.getItem("theme");
				var prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				var theme =
					stored === "dark" || stored === "light"
						? stored
						: prefersDark
							? "dark"
							: "light";
				document.documentElement.dataset.theme = theme;
			})();
			// Keep data-theme in sync across ViewTransitions page swaps
			document.addEventListener("astro:before-swap", function (e) {
				e.newDocument.documentElement.dataset.theme =
					document.documentElement.dataset.theme;
			});
		</script>
		<ViewTransitions />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="logo" aria-label="Christian Whitmer — home">
					<img
						src={avatar.src}
						alt=""
						class="logo-mark"
						width="34"
						height="34"
						aria-hidden="true"
					/>
					<span class="logo-text">Christian Whitmer</span>
				</a>
				<div class="nav-right">
					<ul class="nav-links" role="list">
						<li>
							<a
								href="/"
								aria-current={path === "/" ? "page" : undefined}
								>Home</a
							>
						</li>
						<li><a href="/#blog">Blog</a></li>
						<li>
							<a
								href="/about"
								aria-current={path === "/about"
									? "page"
									: undefined}>About</a
							>
						</li>
					</ul>
					<ThemeToggle />
					<button
						class="nav-burger"
						id="nav-burger"
						aria-label="Open navigation menu"
						aria-expanded="false"
						aria-controls="nav-mobile"
					>
						<span class="burger-bar"></span>
						<span class="burger-bar"></span>
						<span class="burger-bar"></span>
					</button>
				</div>
			</nav>
			<div class="nav-mobile" id="nav-mobile" aria-hidden="true">
				<ul role="list">
					<li>
						<a
							href="/"
							aria-current={path === "/" ? "page" : undefined}
							>Home</a
						>
					</li>
					<li><a href="/#blog">Blog</a></li>
					<li>
						<a
							href="/about"
							aria-current={path === "/about"
								? "page"
								: undefined}>About</a
						>
					</li>
				</ul>
			</div>
		</header>

		<script is:inline>
			const burger = document.getElementById("nav-burger");
			const mobileMenu = document.getElementById("nav-mobile");
			function toggleMenu(open) {
				burger.setAttribute("aria-expanded", String(open));
				mobileMenu.setAttribute("aria-hidden", String(!open));
				burger.classList.toggle("is-open", open);
				mobileMenu.classList.toggle("is-open", open);
			}
			burger.addEventListener("click", () => {
				const isOpen = burger.getAttribute("aria-expanded") === "true";
				toggleMenu(!isOpen);
			});
			// Close on link click
			mobileMenu
				.querySelectorAll("a")
				.forEach((a) =>
					a.addEventListener("click", () => toggleMenu(false)),
				);
			// Close on page nav (ViewTransitions)
			document.addEventListener("astro:after-swap", () =>
				toggleMenu(false),
			);
		</script>

		<main
			class="main"
			id="main-content"
			style="view-transition-name: main-content"
		>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<span class="footer-name">Christian Whitmer</span>
					<p class="footer-tagline">
						Writing about software, the web, and whatever I happen
						to be building.
					</p>
				</div>
				<div class="footer-right">
					<div class="footer-social">
						<a
							href="https://github.com/cwhit-io"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="GitHub"
						>
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
								><path
									d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
								></path></svg
							>
						</a>
						<a href="/rss.xml" aria-label="RSS Feed">
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
								><path
									d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"
								></path></svg
							>
						</a>
					</div>
					<div class="footer-links">
						<a href="/rss.xml">RSS</a>
						<span aria-hidden="true">&middot;</span>
						<a href="/sitemap-index.xml">Sitemap</a>
					</div>
				</div>
			</div>
			<div class="footer-bottom">
				<p>
					&copy; {new Date().getFullYear()} Christian Whitmer &mdash; Built
					with <a
						href="https://astro.build"
						target="_blank"
						rel="noopener noreferrer">Astro</a
					>
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	/* ── Site header ── */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--header-bg) 92%, transparent) 0%,
			color-mix(in srgb, var(--header-bg) 55%, transparent) 100%
		);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 2px solid var(--accent);
		box-shadow: var(--shadow-1);
		transition:
			background var(--trans-1),
			border-color var(--trans-1);
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-body);
	}

	/* ── Logo ── */
	.logo {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
		flex-shrink: 0;
		transition: opacity var(--trans-1);
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo-mark {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		border: 2px solid var(--accent);
	}

	.logo-text {
		font-family: var(--font-title);
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1;
		color: var(--text-primary);
	}

	.logo:hover .logo-text {
		color: var(--accent);
	}

	/* ── Desktop nav links ── */
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 0.125rem;
	}

	.nav-links a {
		display: block;
		padding: 0.375rem 0.8rem;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-decoration: none;
		transition:
			color var(--trans-1),
			background var(--trans-1);
	}

	.nav-links a:hover {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}

	.nav-links a[aria-current="page"] {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		font-weight: 700;
	}

	/* ── Hamburger button ── */
	.nav-burger {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 36px;
		height: 36px;
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
		border-radius: 8px;
		cursor: pointer;
		padding: 0;
		transition:
			background var(--trans-1),
			border-color var(--trans-1);
		flex-shrink: 0;
	}

	.nav-burger:hover {
		background: color-mix(in srgb, var(--accent) 20%, transparent);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}

	.burger-bar {
		display: block;
		width: 16px;
		height: 2px;
		background: var(--text-primary);
		border-radius: 2px;
		transition:
			transform var(--trans-1),
			opacity var(--trans-1);
	}

	/* Animate burger → X */
	.nav-burger.is-open .burger-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.nav-burger.is-open .burger-bar:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}

	.nav-burger.is-open .burger-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* ── Mobile dropdown menu ── */
	.nav-mobile {
		display: none;
		overflow: hidden;
		max-height: 0;
		transition:
			max-height var(--trans-card),
			padding var(--trans-card);
		border-top: 1px solid var(--divider);
	}

	.nav-mobile.is-open {
		max-height: 200px;
		padding: 0.5rem 0;
	}

	.nav-mobile ul {
		list-style: none;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.nav-mobile a {
		display: block;
		padding: 0.625rem 0.875rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-decoration: none;
		transition:
			color var(--trans-1),
			background var(--trans-1);
	}

	.nav-mobile a:hover {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}

	.nav-mobile a[aria-current="page"] {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		font-weight: 700;
	}

	/* ── Main & Footer ── */
	.main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		min-height: calc(100dvh - 64px - 60px);
	}

	.site-footer {
		border-top: 1px solid var(--divider);
		background: var(--header-bg);
		font-size: 0.875rem;
		color: var(--text-secondary);
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 1.25rem;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.footer-name {
		display: block;
		font-family: var(--font-title);
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.375rem;
	}

	.footer-tagline {
		color: var(--text-secondary);
		max-width: 32ch;
		line-height: 1.5;
		margin: 0;
	}

	.footer-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.625rem;
	}

	.footer-social {
		display: flex;
		gap: 0.75rem;
	}

	.footer-social a {
		display: flex;
		align-items: center;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color var(--trans-1);
	}

	.footer-social a:hover {
		color: var(--accent);
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-secondary);
	}

	.footer-links a {
		color: var(--text-secondary);
		text-decoration: none;
		transition: color var(--trans-1);
	}

	.footer-links a:hover {
		color: var(--text-primary);
	}

	.footer-bottom {
		border-top: 1px solid var(--divider);
		text-align: center;
		padding: 0.875rem 1.5rem;
		font-size: 0.78rem;
		color: var(--text-secondary);
	}

	.footer-bottom a {
		color: var(--accent);
		text-decoration: none;
	}

	.footer-bottom a:hover {
		text-decoration: underline;
	}

	/* ── ThemeToggle override — scoped to header context ── */
	:global(.site-header #theme-toggle) {
		border-color: color-mix(in srgb, var(--accent) 22%, transparent);
		color: var(--text-secondary);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}

	:global(.site-header #theme-toggle:hover) {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}

	/* ── Mobile breakpoint ── */
	@media (max-width: 640px) {
		.nav-links {
			display: none;
		}

		.nav-burger {
			display: flex;
		}

		.nav-mobile {
			display: block;
		}

		.main {
			padding: 2rem 1rem;
		}

		.footer-inner {
			flex-direction: column;
		}
		.footer-right {
			align-items: flex-start;
		}
	}
</style>
