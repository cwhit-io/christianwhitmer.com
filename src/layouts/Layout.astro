---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Christian Whitmer',
	description = 'Thoughts, projects, and updates on web development and technology.',
} = Astro.props;

const pageTitle =
	title === 'Christian Whitmer' ? title : `${title} — Christian Whitmer`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Christian Whitmer" />
		<link rel="alternate" type="application/rss+xml" title="Christian Whitmer's Blog" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..800&display=swap" rel="stylesheet" />
		<!-- Prevent dark mode flash before ViewTransitions -->
		<script is:inline>
			const stored = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			if (stored === 'dark' || (!stored && prefersDark)) {
				document.documentElement.classList.add('dark');
			}
		</script>
		<ViewTransitions />
	</head>
	<body>
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="logo" aria-label="Christian Whitmer — home">
					<span class="logo-mark">CW</span>
					<span class="logo-text">Christian Whitmer</span>
				</a>
				<div class="nav-right">
					<ul class="nav-links">
						<li><a href="/">Home</a></li>
						<li><a href="/#blog">Blog</a></li>
					</ul>
					<ThemeToggle />
				</div>
			</nav>
		</header>

		<main class="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<p>&copy; {new Date().getFullYear()} Christian Whitmer. All rights reserved.</p>
				<div class="footer-links">
					<a href="/rss.xml">RSS</a>
					<a href="/sitemap-index.xml">Sitemap</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg-nav);
		border-bottom: 1px solid var(--border);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
		color: var(--text);
		transition: opacity 0.2s;
		flex-shrink: 0;
	}

	.logo:hover { opacity: 0.75; }

	.logo-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: var(--accent);
		color: #fff;
		border-radius: 8px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		flex-shrink: 0;
	}

	.logo-text {
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 0.125rem;
	}

	.nav-links a {
		display: block;
		padding: 0.375rem 0.75rem;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--text-3);
		text-decoration: none;
		transition: color 0.15s, background 0.15s;
	}

	.nav-links a:hover {
		color: var(--text);
		background: color-mix(in srgb, var(--border) 150%, transparent);
	}

	.main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		min-height: calc(100dvh - 64px - 60px);
	}

	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--bg-nav);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.125rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		font-size: 0.82rem;
		color: var(--text-3);
	}

	.footer-links {
		display: flex;
		gap: 1.25rem;
	}

	.footer-links a {
		color: var(--text-3);
		text-decoration: none;
		transition: color 0.15s;
	}

	.footer-links a:hover { color: var(--accent-2); }

	@media (max-width: 640px) {
		.logo-text { display: none; }
		.main { padding: 2rem 1rem; }
		.footer-inner { flex-direction: column; text-align: center; }
	}
</style>
