# Monica AI API key (required)
# Get yours at: https://monica.im/api
MONICA_API_KEY=your_api_key_here

# Text model to use for blog generation (required)
# Common options: gpt-4o, gpt-4o-mini, claude-3-5-sonnet
MONICA_MODEL=gpt-4o

# FLUX model for header image generation (optional, default: flux_schnell)
# Options: flux_schnell (fast/cheap), flux_dev (balanced), flux_pro (best quality)
MONICA_FLUX_MODEL=flux_schnell
